rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Events collection
    match /events/{eventId} {
      // Anyone authenticated can read events
      allow read: if isAuthenticated();
      // Only admins can write events
      allow create, update, delete: if isAdmin();

      // Stalls subcollection
      match /stalls/{stallId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAdmin();
      }

      // Schedule subcollection
      match /schedule/{scheduleId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAdmin();
      }

      // Amenities subcollection
      match /amenities/{amenityId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAdmin();
      }
    }

    // Admins collection (only admins can read)
    match /admins/{userId} {
      allow read: if isAdmin();
      allow write: if false; // Never allow direct writes to admin collection
    }
  }
}
