{
  "name": "eventpilot-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "web:dev": "turbo run dev --filter=@eventpilot/web",
    "admin:dev": "turbo run dev --filter=@eventpilot/admin"
  },
  "devDependencies": {
    "turbo": "^2.3.6",
    "typescript": "^5"
  },
  "packageManager": "bun@1.1.46",
  "engines": {
    "node": ">=18"
  }
}
